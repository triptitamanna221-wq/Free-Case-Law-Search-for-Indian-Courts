# Server-side only, read by app/api/*/route.ts (the proxy routes to the
# FastAPI backend). Deliberately NOT prefixed with NEXT_PUBLIC_ -- it never
# needs to reach the browser bundle, since the browser only ever calls this
# app's own same-origin /api/* routes.
API_BASE_URL=http://localhost:8000
# Production example: API_BASE_URL=https://case-law-search-api.onrender.com

# Demo mode: set to "true" to exercise the full UI against realistic mock
# data with zero backend required. Must be NEXT_PUBLIC_ (read client-side).
NEXT_PUBLIC_USE_MOCK_DATA=false
